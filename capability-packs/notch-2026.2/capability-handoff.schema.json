{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seed-loom.local/schemas/notch-2026.2/capability-handoff.schema.json",
  "title": "Seed Loom Resolved Capability Handoff",
  "description": "Deterministic execution contract emitted from a capability pull request and the locally verified candidate pack.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "request", "packReceipt", "scene", "families", "adapter", "workOrder"],
  "properties": {
    "schemaVersion": { "const": "seed-loom.capability-handoff.v0.1" },
    "request": { "type": "object" },
    "packReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "packStatus", "digest"],
      "properties": {
        "packId": { "type": "string", "pattern": "^capability-pack:" },
        "packStatus": { "const": "candidate" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "scene": { "type": "object" },
    "families": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "adapter": { "type": "object" },
    "workOrder": { "type": "object" }
  }
}
