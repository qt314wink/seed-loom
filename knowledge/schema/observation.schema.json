{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seed-loom.local/schema/observation.schema.json",
  "title": "Observation",
  "description": "Canonical observation record. Daily intake may create only candidate approval state; accepted knowledge requires a separate governed transition. Temporal fields describe validity and review boundaries; temporal evaluation must never mutate base confidence.",
  "type": "object",
  "required": ["id", "type", "capturedAt", "claim", "verifiedFacts", "inference", "significance", "confidence", "evidenceMaturity", "sourceRefs", "approvalState"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.1.0"},
    "id": {"type": "string", "pattern": "^obs:[a-z0-9][a-z0-9._:-]+$"},
    "type": {"const": "Observation"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "claim": {"type": "string", "minLength": 20},
    "verifiedFacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inference": {"type": "array", "items": {"type": "string"}},
    "significance": {"type": "string", "minLength": 10},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidenceMaturity": {"enum": ["captured", "candidate", "source-backed", "reviewed", "accepted", "implemented", "measured", "superseded", "rejected"]},
    "evidenceClass": {"enum": ["pricing", "funding", "law-or-policy", "provider-terms", "model-capability", "procurement", "opportunity", "peer-reviewed-research", "historical", "default"]},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": ["string", "null"], "format": "date-time"},
    "reviewBy": {"type": ["string", "null"], "format": "date-time"},
    "termsChangedAt": {"type": ["string", "null"], "format": "date-time"},
    "closedAt": {"type": ["string", "null"], "format": "date-time"},
    "closureRef": {"type": ["string", "null"]},
    "supersededBy": {"type": ["string", "null"]},
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "actorRefs": {"type": "array", "items": {"type": "string"}},
    "affectedRepositories": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "knownLimitations": {"type": "array", "items": {"type": "string"}},
    "counterevidenceRefs": {"type": "array", "items": {"type": "string"}},
    "approvalState": {"enum": ["candidate", "pending", "approved", "rejected", "not-required"]}
  },
  "additionalProperties": false
}
