{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seed-loom.local/schema/experiment.schema.json",
  "title": "Experiment",
  "type": "object",
  "required": ["id", "type", "opportunityRef", "hypothesis", "dangerousAssumption", "method", "passCriteria", "failCriteria", "stopConditions", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^experiment:[a-z0-9][a-z0-9._:-]+$"},
    "type": {"const": "Experiment"},
    "opportunityRef": {"type": "string"},
    "hypothesis": {"type": "string", "minLength": 20},
    "dangerousAssumption": {"type": "string", "minLength": 10},
    "method": {"type": "string", "minLength": 20},
    "passCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "costCeiling": {"type": ["number", "null"], "minimum": 0},
    "durationDays": {"type": ["integer", "null"], "minimum": 1},
    "status": {"enum": ["proposed", "approved", "running", "passed", "failed", "stopped", "inconclusive"]},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "approvalState": {"enum": ["pending", "approved", "rejected"]}
  },
  "additionalProperties": false
}
