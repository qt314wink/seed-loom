{
  "name": "seed-loom",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:atelier": "playwright test tests/filter-atelier.spec.ts",
    "filters:check": "npm --prefix packages/svg-filter-atlas run check",
    "check": "npm run filters:check && npm run build",
    "filters:build": "npm --prefix packages/svg-filter-atlas run build",
    "typecheck": "npm run filters:build && tsc --noEmit",
    "knowledge:setup": "node scripts/knowledge/setup.mjs",
    "knowledge:doctor": "node scripts/knowledge/doctor.mjs",
    "knowledge:test": "node scripts/knowledge/test-pipeline.mjs",
    "knowledge:test:contract": "node scripts/knowledge/test-contract-phase-a.mjs",
    "knowledge:test:integrity": "node scripts/knowledge/test-integrity-engine.mjs",
    "knowledge:test:independence": "node scripts/knowledge/test-source-independence.mjs",
    "knowledge:test:claim-identity": "node scripts/knowledge/test-semantic-duplicates.mjs",
    "knowledge:test:temporal": "node scripts/knowledge/test-temporal-decay.mjs",
    "knowledge:integrity": "node scripts/knowledge/integrity-engine.mjs",
    "knowledge:independence": "node scripts/knowledge/analyze-source-independence.mjs",
    "knowledge:claim-identity": "node scripts/knowledge/detect-semantic-duplicates.mjs",
    "knowledge:temporal": "node scripts/knowledge/apply-temporal-decay.mjs",
    "knowledge:validate": "node scripts/knowledge/validate.mjs",
    "knowledge:controls": "node scripts/knowledge/run-controls.mjs",
    "knowledge:run": "node scripts/knowledge/run-all.mjs",
    "knowledge:verify": "npm run knowledge:doctor && npm run knowledge:test:contract && npm run knowledge:test:integrity && npm run knowledge:test:independence && npm run knowledge:test:claim-identity && npm run knowledge:test:temporal && npm run knowledge:test && npm run knowledge:controls && npm run knowledge:run",
    "knowledge:verify:observed": "node scripts/knowledge/run-observed.mjs",
    "knowledge:weekly": "node scripts/knowledge/weekly-review.mjs",
    "knowledge:ingest": "node scripts/knowledge/ingest-nightly-run.mjs",
    "knowledge:graph:build": "node scripts/knowledge/build-workbench.mjs",
    "knowledge:graph": "node scripts/knowledge/serve-workbench.mjs",
    "observability:up": "docker compose -f observability/docker-compose.yml up -d",
    "observability:down": "docker compose -f observability/docker-compose.yml down",
    "contract:check": "node scripts/reproducibility/check-root-contract.mjs",
    "schemas:check": "node scripts/reproducibility/check-schemas.mjs",
    "artifact:check": "node scripts/reproducibility/check-artifact.mjs",
    "verify:root": "npm ci && npx playwright install chromium && npm run contract:check && npm run typecheck && npm run build && npm run test:visual && npm run schemas:check && npm run artifact:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  },
  "dependencies": {
    "@melodicbloom/svg-filter-atlas": "file:packages/svg-filter-atlas"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <23"
  }
}
